 
#include <stdlib.h>
#include <stdio.h>

typedef struct No {

	int valor;
	struct No *prox;


} No;


void IniciarLista(int a, No **lista) {

	No *novo = malloc(sizeof(No));

	if(novo == NULL) {

		printf("erro na alocação: \n");
		return;
	}

	novo->valor = a;
	novo->prox = NULL;

	*lista = novo;

}

void imprimirlista(No *lista) {

	No *atual = lista;

	while(atual != NULL) {
		printf("%d -> ", atual->valor);
		atual = atual->prox;

	}
	printf("NULL\n");

}

void RemoverValor(No **lista){
    
    if(*lista == NULL){
       
        printf("lista vazia");
        return;
    }
    
    No *aux = *lista;
    
    *lista = (*lista)->prox;
    
    free(aux);
    
}

void InserirFim(int a, No *lista) {

 No *novo = malloc(sizeof(No));
	if(novo == NULL) {

		printf("erro na alocação: \n");
		return;
	}

novo->valor = a;
novo->prox = NULL;

 No *atual = lista;
 
 while(atual->prox != NULL){
     
     atual = atual->prox;
}
atual->prox = novo;
}

int main()
{

No *lista;

IniciarLista(10,&lista);

InserirFim(12,lista);

InserirFim(14,lista);

InserirFim(15,lista);

RemoverValor(&lista);

InserirFim(16,lista);

imprimirlista(lista);
	return 0;
}
