#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef enum {
    TIPO_INT,
    TIPO_FLOAT,
    TIPO_STRING
} Tipo;

typedef struct No {
    Tipo tipo;
    void *dado;
    struct No *prox;
} No;

No *criarNo(Tipo tipo, void *dado) {
    No *novo = malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro ao alocar memoria.\n");
        exit(1);
    }

    novo->tipo = tipo;
    novo->dado = dado;
    novo->prox = NULL;

    return novo;
}

void inserirFim(No **lista, Tipo tipo, void *dado) {

    No *novo = criarNo(tipo, dado);

    if (*lista == NULL) {
        *lista = novo;
        return;
    }

    No *aux = *lista;

    while (aux->prox != NULL) {
        aux = aux->prox;
    }

    aux->prox = novo;
}

void imprimirLista(No *lista) {

    No *aux = lista;

    while (aux != NULL) {

        if (aux->tipo == TIPO_INT) {
            printf("INT: %d\n", *(int *)aux->dado);
        }

        else if (aux->tipo == TIPO_FLOAT) {
            printf("FLOAT: %.2f\n", *(float *)aux->dado);
        }

        else if (aux->tipo == TIPO_STRING) {
            printf("STRING: %s\n", (char *)aux->dado);
        }

        aux = aux->prox;
    }
}

void liberarLista(No **lista) {

    No *aux;

    while (*lista != NULL) {

        aux = *lista;

        *lista = (*lista)->prox;

        free(aux->dado);
        free(aux);
    }
}

int main() {

    No *lista = NULL;

    int *numero = malloc(sizeof(int));
    *numero = 10;

    float *decimal = malloc(sizeof(float));
    *decimal = 3.14;

    char *nome = malloc(20 * sizeof(char));
    strcpy(nome, "Joao");

    inserirFim(&lista, TIPO_INT, numero);
    inserirFim(&lista, TIPO_FLOAT, decimal);
    inserirFim(&lista, TIPO_STRING, nome);

    printf("LISTA:\n\n");

    imprimirLista(lista);

    liberarLista(&lista);

    return 0;
}
